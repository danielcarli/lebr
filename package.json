{
  "name": "lebr",
  "productName": "LEBR",
  "version": "0.64.0",
  "description": "LEBR — Laboratório de Estruturas Brasil: sistema aberto e modular para cálculo de estruturas de concreto armado e de madeira segundo as normas brasileiras.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/main/main.cjs",
  "author": "Daniel Michelon De Carli",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "validar": "node scripts/validar.mjs",
    "dist:win": "electron-builder --win nsis-web --x64 --publish never && node tools/preparar-release.mjs",
    "dist:win:portatil": "electron-builder --win portable --x64",
    "dist:win:completo": "electron-builder --win nsis --x64",
    "fonte": "git archive --format=zip --prefix=lebr/ -o lebr-fonte.zip HEAD",
    "instalador": "iscc instalador/lebr.iss",
    "confiabilidade": "node scripts/confiabilidade.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielcarli/lebr.git"
  },
  "homepage": "https://github.com/danielcarli/lebr",
  "build": {
    "appId": "br.lebr.app",
    "productName": "LEBR",
    "copyright": "Copyright (C) 2026 Daniel Michelon De Carli — AGPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "exemplos/**/*",
      "tutoriais/**/*",
      "validacao/casos/**/*",
      "LICENSE",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "validacao/casos/**",
      "tutoriais/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "danielcarli",
        "repo": "lebr",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LEBR-Setup-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEBR",
      "license": "LICENSE",
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LEBR-Setup-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "LEBR-${version}-portatil-win-x64.${ext}"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum",
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEBR",
      "license": "LICENSE",
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LEBR-Setup-win-x64.${ext}",
      "appPackageUrl": "https://github.com/danielcarli/lebr/releases/latest/download/lebr-x64.nsis.7z"
    }
  }
}
