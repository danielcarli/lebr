{
  "name": "lebr",
  "productName": "LEBR",
  "version": "0.69.0",
  "description": "LEBR — Laboratório de Estruturas Brasil: sistema aberto e modular para cálculo de estruturas de concreto armado e de madeira segundo as normas brasileiras.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/main/main.cjs",
  "desktopName": "lebr.desktop",
  "author": "Daniel Michelon De Carli",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "validar": "node scripts/validar.mjs",
    "dist:win": "electron-builder --win nsis-web --x64 --publish never && node tools/preparar-release.mjs",
    "dist:win:portatil": "electron-builder --win portable --x64",
    "dist:win:completo": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "fonte": "git archive --format=zip --prefix=lebr/ -o lebr-fonte.zip HEAD",
    "instalador": "iscc instalador/lebr.iss",
    "confiabilidade": "node scripts/confiabilidade.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielcarli/lebr.git"
  },
  "homepage": "https://github.com/danielcarli/lebr",
  "build": {
    "appId": "br.lebr.app",
    "productName": "LEBR",
    "copyright": "Copyright (C) 2026 Daniel Michelon De Carli — AGPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "exemplos/**/*",
      "tutoriais/**/*",
      "validacao/casos/**/*",
      "LICENSE",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "validacao/casos/**",
      "tutoriais/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "danielcarli",
        "repo": "lebr",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LEBR-Setup-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEBR",
      "license": "LICENSE",
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LEBR-Setup-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "LEBR-${version}-portatil-win-x64.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Science",
      "synopsis": "Cálculo de estruturas de concreto armado e de madeira pelas normas brasileiras",
      "maintainer": "Daniel Michelon De Carli",
      "executableName": "lebr",
      "desktop": {
        "entry": {
          "Name": "LEBR",
          "GenericName": "Cálculo estrutural",
          "Comment": "Laboratório de Estruturas Brasil",
          "Keywords": "estrutura;concreto;madeira;NBR;engenharia;",
          "StartupWMClass": "LEBR"
        }
      },
      "artifactName": "LEBR-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "LEBR-linux-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "LEBR-linux-amd64.deb",
      "packageCategory": "science",
      "priority": "optional"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "LEBR-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "LEBR ${version}",
      "artifactName": "LEBR-mac-${arch}.dmg"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum",
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEBR",
      "license": "LICENSE",
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LEBR-Setup-win-x64.${ext}",
      "appPackageUrl": "https://github.com/danielcarli/lebr/releases/latest/download/lebr-x64.nsis.7z"
    }
  }
}
